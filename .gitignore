# Visual Studio
.vs/

# Asset meta data should only be ignored when the corresponding asset is also ignored
*.booproj
*.svd
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Ignore crash logs
*.stackdump

# Rider / VS Code / JetBrains
.idea/
.vscode/
*.DotSettings

# .NET build output (bin/ and obj/ also carry their own .gitignore)
*.user
*.Backup.tmp

# Runtime binaries - BinaryUtils downloads these on first launch
Resources/Bin/
